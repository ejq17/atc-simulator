# Copy to `.env` (git-ignored) and fill in. NEVER commit real keys.
# The backend (`npm run server`) loads this file; the browser never sees these values.

# Deepgram API key used ONLY by the local backend to mint short-lived browser tokens
# (optional: without it the app falls back to browser speech recognition).
# Needs at least Member permissions. https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Port for the local backend (the Vite dev server runs on 5173).
PORT=8787

# Anthropic API key used ONLY by the local backend for the phrase interpreter, the LLM fallback for
# transmissions the rule grammar cannot read (optional: without it the app uses the grammar alone).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model for the phrase interpreter. Measured with the real API (warm prompt cache): claude-opus-5-5 at effort low takes
# about 2.5-4 s per call. claude-haiku-5-5 is the faster, cheaper alternative (about 1.5-3 s with ATC_LLM_THINKING=off)
# but it misread one of three test phrasings.
ATC_LLM_MODEL=claude-opus-5-5
# Reasoning effort for the interpreter: low | medium | high | xhigh | max (low keeps latency down).
ATC_LLM_EFFORT=low
# Optional: `off` sends thinking disabled, only when the model is a Haiku model (Opus 5.5 rejects disabled thinking with a 400,
# so it is never sent for other models). Leave unset for the model default.
# ATC_LLM_THINKING=off
